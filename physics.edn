;; What this occupation's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a filing-intake and archival robot performs
;; return-receipt scanning, filing-record logging, audit-appointment-slot
;; scheduling and office supply-order coordination (ISCO 3352 government tax
;; and excise officials); it never assesses, penalizes or collects. Its
;; physical work: lifting trays of received paper returns to the scanner, and
;; archiving filed returns in a fire-resistant records cabinet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3352"
 :cases
 [{:id :returns-tray-to-scanner
   :kind :manipulator
   :procedure "arm lifts a tray of received paper returns from the mail-opening bench to the scanner feed shelf"
   :params {:l1-m 0.40 :l2-m 0.35 :m1-kg 3.0 :m2-kg 2.0
            :from [0.50 0.05] :to [0.25 0.55] :duration-s 2.0 :steps 400}
   :sweep {:param :payload-kg :values [0.5 1.5 3.0 4.5 6.0]}
   :quantity :peak-tau1-nm
   :limit {:max 40.0 :basis "estimate: continuous shoulder torque of a ~4 kg-payload desktop arm"}
   :boundary {:lo 0.1 :hi 15.0}}
  {:id :returns-cabinet-fire-wall
   :kind :thermal
   :procedure "one hour of furnace exposure (face held at 927 °C, no cool-down modeled) on a ceramic-fibre-insulated records cabinet wall; interior face temperature"
   :params {:conductivity-w-mk 0.08 :density-kg-m3 250.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 927.0 :front-fixed? true :t-back-ambient-c 20.0 :h-back-w-m2k 5.0
            :threshold-c 177.0 :duration-s 3600.0}
   :sweep {:param :thickness-m :values [0.02 0.04 0.06 0.08 0.10]}
   :quantity :final-back-c
   :limit {:max 177.0 :basis "UL 72 Class 350 (paper records): interior must not exceed 350 °F (177 °C) during the fire-endurance test"}
   :boundary {:lo 0.01 :hi 0.12}}]}
